{
  "name": "@wazoo/workspace",
  "version": "0.8.1",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "wspace": "./src/cli.ts"
  },
  "imports": {
    "@/": "./src/",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "@types/node": "npm:@types/node@^26.6.6"
  },
  "nodeModulesDir": "auto",
  "lock": {
    "frozen": true
  },
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "build": "deno compile --allow-read --allow-write --allow-run=git,gh,robocopy,rmdir,rm --output wspace src/cli.ts",
    "ci": "deno fmt --check && deno lint && deno task lint:imports && deno check src/ tests/ && deno task test",
    "lint:imports": "deno run --allow-read scripts/lint_imports.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env"
  },
  "publish": {
    "include": [
      "src/",
      "schema/",
      "skills/",
      "LICENSE",
      "README.md"
    ]
  }
}
