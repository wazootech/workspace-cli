{
  "name": "@wazoo/workspace",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "works": "./src/cli.ts"
  },
  "imports": {
    "@/": "./src/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.2.0"
  },
  "tasks": {
    "build": "deno compile --allow-read --allow-write --allow-run=git --output works src/cli.ts",
    "ci": "deno fmt --check && deno lint && deno task lint:imports && deno check src/ tests/ && deno task test",
    "lint:imports": "deno run --allow-read scripts/lint_imports.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env"
  },
  "publish": {
    "include": ["src/", "schema/", "skills/", "LICENSE", "README.md"]
  }
}
